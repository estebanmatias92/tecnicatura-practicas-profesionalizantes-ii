@startuml
title BiblioTech — Validación y mensajes de validación

skinparam classAttributeIconSize 0
skinparam shadowing false

package "Model (dominio)" as Model {

  abstract class DomainError {
    +status: number
    +code: string
    #message: string
  }

  class ValidationError {
    +status = 400
    +code = "VALIDATION"
  }

  class UserValidator {
    +{static} assertValidRole(role): Role
    +{static} assertValidRegistration(email, password)
    +{static} assertValidCreation(email, password, role)
  }

  class EmailValidator {
    +{static} normalize(email): string
    +{static} assertValid(email): string
  }

  class PasswordValidator {
    +{static} assertValid(password): void
  }

  class Catalog {
    +catalog: { es: { key: message }, en: { key: message } }
    +RESOURCE_INVALID_KEY
    +SUPPORTED_LOCALES
  }

  class LanguageManager {
    +getLanguage(): Locale
    +setLanguage(locale): boolean
    +resolve(key, params?): string
  }

  class FileValidator
  class MaterialValidator

  DomainError <|-- ValidationError
  UserValidator ..> EmailValidator
  UserValidator ..> PasswordValidator
  EmailValidator ..> ValidationError : lanza
  PasswordValidator ..> ValidationError : lanza
  UserValidator ..> ValidationError : lanza
  EmailValidator ..> LanguageManager : resolve
  PasswordValidator ..> LanguageManager : resolve
  LanguageManager ..> Catalog : lee claves
}

package "Controller (REST)" as Controller {

  class RegisterDto {
    +email: string
    +password: string
  }

  class LoginDto {
    +email: string
    +password: string
  }

  class ValidationPipe {
    +whitelist = true
    +transform = true
    +exceptionFactory = localizada
  }

  class DomainExceptionFilter {
    +catch(exception, host): void
  }
}

RegisterDto ..> ValidationPipe
LoginDto ..> ValidationPipe
ValidationPipe ..> LanguageManager : resolve
DomainExceptionFilter ..> DomainError : captura

note bottom of ValidationError
  El texto ya viene resuelto por el
  validador desde el catálogo.
  El cliente puede ramificar por
  error: "VALIDATION" sin depender
  del idioma.
end note

legend right
  **Fallback de mensajes**
  idioma activo → es → validation.resource.invalid
  APP_LANGUAGE (es/en) define el activo al iniciar;
  setLanguage() lo cambia en caliente.
endlegend

@enduml
