{
  "name": "bibliotech-backend",
  "version": "0.1.0",
  "private": true,
  "description": "BiblioTech backend — NestJS + Clean 4 Layers (Entities → UseCases → Adapters → Frameworks)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/frameworks/main.js",
    "start:dev": "node --experimental-strip-types --no-warnings src/frameworks/main.ts 2>/dev/null || ts-node src/frameworks/main.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest --silent",
    "test:cov": "jest --coverage --silent"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
