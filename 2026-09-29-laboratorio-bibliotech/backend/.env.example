# BiblioTech — variables de entorno (copiar a .env; NUNCA commitear .env — NFR-004)
# DB (RST-003 MariaDB 11; compose usa estos mismos nombres)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bibliotech
DB_USER=bibliotech
DB_PASSWORD=bibliotech
DB_SYNCHRONIZE=true
# Auth (NFR-003: BCrypt cost 10 fijo en codigo; JWT <= 24h)
JWT_SECRET=cambiar-por-secreto-largo-aleatorio
JWT_EXPIRES_H=24
# Storage (RST-005 PDF/EPUB <= 50MB; NFR-002 streaming)
UPLOAD_DIR=./uploads
# API
PORT=3000
CORS_ORIGIN=http://localhost:5173
