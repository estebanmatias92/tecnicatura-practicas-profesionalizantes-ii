@startuml sequence-diagram-UC-006
title Sequence UC-006 Descargar archivo original — FR-008 / BR-002 / NFR-005
actor "Lector autenticado" as Actor
participant "JwtAuthGuard\n(Adapter)" as Guard
participant "MaterialsController\n(Adapter)" as Ctrl
participant "DownloadFileUseCase\n(Controller)" as UC
participant "MaterialRepository\n+ FileBlobRepository" as Repo
participant "FileStorage\n(port)" as FS

Actor -> Ctrl : GET /material/:id/file (JWT)
' GRASP Indirection — Mission: both sides depend on something stable
Guard -> Ctrl : verify(token) [401 PRIMERO aunque el id no exista, BR-002]
' GRASP Controller — Mission: single entry point per system operation, UI stays thin
Ctrl -> UC : execute(materialId)
' GRASP Information Expert — Mission: co-locate behavior with information
UC -> Repo : MaterialRepository.findById(materialId) [-> 404]
Repo --> UC : material / null
UC -> Repo : FileBlobRepository.findById(material.blobId)
Repo --> UC : blob / null
alt binario huérfano (blob ausente)
  UC --> Ctrl : INTERNAL -> 500 + log de inconsistencia
else ok
  ' GRASP Indirection — Mission: both sides depend on something stable
  UC -> FS : stream(blob.storageKey) [streaming sin buffer]
  FS --> UC : Stream
  UC --> Ctrl : FileDownload {stream, mime, fileName (normalizado, NFR-005)}
  Ctrl -> Ctrl : res.setHeader('Content-Type', mime); Content-Disposition: inline; filename="{fileName}"
  Ctrl --> Actor : 200 (bytes)
end
alt storage caído (E-001)
  FS --> UC : error -> SERVICE_UNAVAILABLE -> 503
end

note over Actor, UC : El filename sale normalizado (basename/sin CRLF); nunca el crudo del cliente (BT-10/NFR-005)
@enduml
