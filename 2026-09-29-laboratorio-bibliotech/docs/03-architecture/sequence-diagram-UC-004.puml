@startuml sequence-diagram-UC-004
title Sequence UC-004 Gestión Admin + cascada + revocación — FR-011/012/013 / BR-004 / NFR-006
actor Admin
actor Professor
participant "Users / MaterialsController\n(Adapter)" as Ctrl
participant "ManageMaterialUseCase\n(C-1/C-3 + FR-013)" as MM
participant "ManageUsersUseCase\n(C-2 + FR-011)" as MU
participant "Material / User\n(Entities)" as Ent
participant "ValidatorPort" as Val
participant "MaterialRepository\n+ UserRepository\n+ FileBlobRepository" as Repo
participant "FileStorage\n(port)" as FS
database MariaDB as DB

' --- C-1: Professor borra material propio / C-3 Admin ---
Professor -> Ctrl : DELETE /material/:id (JWT)
' GRASP Controller — Mission: single entry point per system operation, UI stays thin
Ctrl -> MM : deleteMaterial({callerId, callerRole, materialId})
' GRASP Information Expert — Mission: co-locate behavior with information
MM -> Repo : MaterialRepository.findById(id)
Repo --> MM : material / null (-> 404)
MM -> Ent : material.isOwnedBy(callerId) [ajeno y no Admin -> 403, nada eliminado]
Ent --> MM : true
MM -> Repo : FileBlobRepository.findById(material.blobId) [lee storageKey para el FS]
Repo --> MM : blob {storageKey}
' ADR-0005: FS-PRIMERO (idempotente) — si falla, la DB no mutó (E-001)
MM -> FS : remove(storageKey)
alt E-001: el FS falla
  FS --> MM : error -> INTERNAL 500 (nada eliminado, DB intacta)
else ok
  ' GRASP Indirection — Mission: both sides depend on something stable
  MM -> Repo : MaterialRepository.deleteWithBlob(id) [transacción DB: materials + file_blobs]
  Repo -> DB : DELETE materials + DELETE file_blobs (C-1/C-3, app-transaction)
  DB --> Repo : ok
  MM --> Ctrl : 204
  note right of MM : si la DB falla tras el remove -> archivo huérfano (fila viva); remove idempotente + reintento de DELETE lo auto-repara (ADR-0005)
end
Ctrl --> Professor : 204 (GET material/file -> 404)

' --- FR-013: Professor/Admin edita material ---
Professor -> Ctrl : PATCH /material/:id {meta} (JWT)
Ctrl -> MM : updateMaterial({callerId, callerRole, materialId, patch})
MM -> Repo : findById(id) [-> 404]
MM -> Ent : material.isOwnedBy(callerId) [ajeno y no Admin -> 403, nada modificado]
' GRASP Pure Fabrication — Mission: protect domain cohesion; reglas fuera de Material
MM -> Val : validateMetadata(patch) [400]
MM -> Ent : material.applyPatch(patch) [Information Expert]
MM -> Repo : save(material)
Repo -> DB : UPDATE materials
Repo --> MM : material
MM --> Ctrl : MaterialDTO -> 200

' --- FR-011: Admin cambia rol + revoca tokens (NFR-006) ---
Admin -> Ctrl : PATCH /users/:id {role} (JWT Admin)
Ctrl -> MU : changeUserRole({callerRole, userId, role})
MU -> Repo : UserRepository.findById(userId) [-> 404]
Repo --> MU : user
' GRASP Information Expert — Mission: co-locate behavior with information
MU -> Ent : user.updateRole(role); user.bumpVersion() [revoca tokens vigentes; ops declaradas en class-diagram.puml:22-23]
MU -> Repo : save(user)
Repo -> DB : UPDATE users SET role, token_version = token_version + 1
Repo --> MU : user (ver nuevo)
MU --> Ctrl : UserDTO -> 200
note over MU, Repo : los JWT ya emitidos llevan ver anterior; JwtAuthGuard (lee token_version) los rechaza -> ventana 0 (NFR-006, ADR-0004)

' --- C-2: Admin borra cuenta Professor con cascada ---
Admin -> Ctrl : DELETE /users/:id (JWT Admin)
Ctrl -> MU : deleteUser({callerId, callerRole, userId})
MU -> Repo : UserRepository.findById(userId) [-> 404]
MU -> Repo : UserRepository.listOwnedStorageKeys(userId) [lee keys ANTES de borrar]
Repo --> MU : storageKeys[]
' ADR-0005: FS-PRIMERO — si falla, la DB no mutó (E-001)
MU -> FS : remove(cada storageKey) [idempotente]
alt E-001: el FS falla
  FS --> MU : error -> INTERNAL 500 (nada eliminado)
else ok
  MU -> Repo : UserRepository.deleteCascade(userId) [transacción DB: users + materials + file_blobs]
  Repo -> DB : DELETE users; DELETE materials; DELETE file_blobs (C-2)
  DB --> Repo : ok
  MU --> Ctrl : 204
end

note over Ctrl, MU : Un UseCase por agregado (High Cohesion); sin God-controller (BT-05 §4). 401 antes que 404 (BR-002).
@enduml
