@startuml c4-container
!theme plain
skinparam linetype ortho

title C4 L2 — Container — BiblioTech (aprobado: Clean 4 Layers)

actor "Professor / Student / Admin" as user

rectangle "Browser SPA\nReact + TS (Vite, Vitest)\nRST-002" as spa
rectangle "API\nNestJS + TS (Node 22)\nJWT + BCrypt + Multer + class-validator\nRST-001 / RST-004" as api
database "MariaDB 11\nRST-003" as mariadb
folder "File storage\nlocal uploads/\nNFR-002 / NFR-005" as fs

user --> spa : "usa (HTTPS)"
spa --> api : "REST + JWT Bearer\nBR-002"
api --> mariadb : "TypeORM Repository\n(RST-004, unica salida a DB)"
api --> fs : "Multer FileInterceptor\n(RST-005: PDF/EPUB <= 50MB)"

note right of api
  NFR-001: p95 lecturas <200ms (FULLTEXT+BTREE, ADR-0006)
  NFR-003: BCrypt >= 10, JWT <= 24h (ADR-0004)
  NFR-004: 0 secretos en claro/logs
  NFR-006: 0 accesos sin token + revocación (token_version, ADR-0004)
end note
@enduml
