@startuml data-model-er
!theme plain
skinparam linetype ortho

title ER — BiblioTech (MariaDB 11, RST-003) — relación normalizada salvo `tags` JSON (tradeoff, ADR-0005)

entity "users" as users {
  * id : INT PK <<auto>>
  * email : VARCHAR(255) UNIQUE
  * password_hash : VARCHAR(255)
  * role : ENUM('Admin','Professor','Student')
  * token_version : INT DEFAULT 0 <<NFR-006, ADR-0004>>
  * created_at : DATETIME
}

entity "materials" as materials {
  * id : INT PK <<auto>>
  * title : VARCHAR(200) <<NN>>
  * author : VARCHAR(120) <<NN>>
  ° subject : VARCHAR(120) NULL
  ° year : INT NULL <<1000..actual>>
  ° edition : VARCHAR(40) NULL
  ° tags : JSON NULL <<<=10, lowercase>>
  * owner_id : INT FK -> users.id <<ON DELETE CASCADE [C-2]>>
  * blob_id : INT FK -> file_blobs.id UNIQUE <<NO ACTION; cascada en transacción de app, ADR-0005>>
  * created_at : DATETIME
  --
  FULLTEXT (title, author, subject) <<q token/prefijo UC-005, NFR-001 — NO infijo, ADR-0006>>
  INDEX (year) <<rango UC-005>>
  INDEX (created_at) <<orden más-reciente v1>>
}

entity "file_blobs" as file_blobs {
  * id : INT PK <<auto>>
  * storage_key : VARCHAR(255) UNIQUE
  * file_name : VARCHAR(255) <<NN, normalizado (basename, sin CRLF) v0.4.1/v0.5.0>>
  * mime : VARCHAR(100) <<PDF/EPUB>>
  * size_bytes : INT <<<=50MB, RST-005>>
  ° content_hash : CHAR(64) NULL <<informativo, NO UNIQUE>>
  * created_at : DATETIME
}

users ||--o{ materials : "owns (owner_id)\nON DELETE CASCADE [C-2] (DB)"
materials ||--|| file_blobs : "stores (blob_id)\nNO ACTION en FK —\ncascada atómica en transacción [C-1/C-3]"

note right of materials
  BR-004 v0.4.0: 1:1 Material:FileBlob,
  nacen y mueren juntos; duplicados
  permitidos (201), sin dedup (BR-007
  eliminada); sin transfer (FR-014 elim.).

  Cascada C-1/C-3 (material -> blob): la FK
  NO usa ON DELETE CASCADE (dirección
  blob->material invertiría el sentido,
  BT-06 §3). Se enforza en un único
  `deleteWithBlob` transaccional + limpieza
  FS (ADR-0005).
end note
note right of file_blobs
  Sin dueño propio, sin refCount,
  sin compartir. contentHash NO gobierna
  nada: sin UNIQUE, sin búsqueda por hash.
  `file_name` es UX (Content-Disposition),
  nunca clave de storage (BR-004).
end note
note bottom of users
  `token_version` (ADR-0004): el JWT lleva `ver`;
  el guard rechaza token con ver != actual.
  Cambio de rol / borrado de cuenta incrementa
  la versión -> revocación con ventana objetivo 0
  (NFR-006, BT-09).
end note
note top of materials
  Calificación normalización: `tags` JSON viola
  1NF estricta; el resto del esquema está en 3NF.
  Tradeoff de escala-lab documentado (join N:M de
  tags rechazado, ADR-0003). AuthSession NO es
  tabla: es un Value Object transitorio (JWT).
end note
@enduml
