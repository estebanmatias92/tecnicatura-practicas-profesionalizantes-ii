@startuml
title BiblioTech — Modelo entidad-relación

hide circle
skinparam linetype ortho

entity "users" as users {
  * id : varchar(36) <<PK>>
  --
  * email : varchar(255) <<UQ>>
  * password_hash : varchar(255)
  * role : varchar(20)
  * token_version : int
  * created_at : datetime
  * updated_at : datetime
}

entity "file_blobs" as blobs {
  * id : varchar(36) <<PK>>
  --
  * storage_key : varchar(255) <<UQ>>
  * original_name : varchar(255)
  * mime_type : varchar(100)
  * size_bytes : int
  * created_at : datetime
}

entity "materials" as materials {
  * id : varchar(36) <<PK>>
  --
  title : varchar(255)
  author : varchar(255)
  description : text
  subject : varchar(120)
  publication_year : int
  * visibility : varchar(20)
  published_at : datetime
  deleted_at : datetime
  * owner_id : varchar(36) <<FK>>
  file_blob_id : varchar(36) <<FK,UQ>>
  * created_at : datetime
  * updated_at : datetime
}

users ||--o{ materials : "owner_id"
materials |o--o| blobs : "file_blob_id"
@enduml
